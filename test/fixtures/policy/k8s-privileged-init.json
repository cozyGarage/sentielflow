{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "privileged-init"
  },
  "spec": {
    "initContainers": [
      {
        "name": "setup",
        "image": "busybox:1.36",
        "securityContext": {
          "privileged": true
        }
      }
    ],
    "containers": [
      {
        "name": "app",
        "image": "nginx:1.25",
        "securityContext": {
          "runAsNonRoot": true
        }
      }
    ]
  }
}
